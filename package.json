{
  "name": "synapse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:api": "pnpm --filter @synapse/api dev",
    "dev:worker": "pnpm --filter @synapse/worker dev",
    "dev:web": "pnpm --filter @synapse/web dev"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
